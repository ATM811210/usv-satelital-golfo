# 1. Planet Labs (PlanetScope 3.0m Daily - Suscripción Comercial $600 USD/mes o Trial 14-30 días)
PLANET_API_KEY=pl_your_commercial_or_trial_api_key_here
PLANET_ITEM_TYPE=PSScene
PLANET_ASSET_TYPE=ortho_analytic_8b_sr

# 2. Copernicus Marine Service (CMEMS - Bottom Temperature, Salinity, Chlorophyll-a)
CMEMS_USERNAME=your_copernicus_username
CMEMS_PASSWORD=your_copernicus_password

# 3. Google Earth Engine (Sentinel-2 L2A 10m + NOAA VIIRS Nighttime SST)
GEE_SERVICE_ACCOUNT=usv-satelital@your-gcp-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./service-account.json

# 4. Base de Datos Espacial PostgreSQL 16 + PostGIS
POSTGRES_USER=usv_admin
POSTGRES_PASSWORD=usv_stealth_48v_2026
POSTGRES_DB=pesca_satelital_gis
DATABASE_URL=postgresql://usv_admin:usv_stealth_48v_2026@localhost:5432/pesca_satelital_gis
