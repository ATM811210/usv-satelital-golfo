# ============================================================================
# CONFIGURACIÓN DE CREDENCIALES SATELITALES 3M, CMEMS (DO/TEMP/SAL) Y STARLINK
# Modalidades: ETAPA_1_SATELITAL ($11,120) | MVP_BAJO_COSTO ($53,949) | GRADO_CIENTIFICO ($148,400)
# ============================================================================

# 1. Planet Labs (PlanetScope SuperDove 3.0m Daily 8-Band - $600 USD/mes o Trial Evaluación)
PLANET_API_KEY=pl_your_commercial_or_trial_api_key_here
PLANET_ITEM_TYPE=PSScene
PLANET_ASSET_TYPE=ortho_analytic_8b_sr

# 2. Copernicus Marine Service (CMEMS - Temperatura Fondo, Salinidad, Clorofila-a y Oxígeno Disuelto DO para Jaiba)
CMEMS_USERNAME=your_copernicus_username
CMEMS_PASSWORD=your_copernicus_password
CMEMS_PHY_DATASET_ID=cmems_mod_glo_phy_anfc_0.083deg_P1D-m
CMEMS_BIO_DO_DATASET_ID=cmems_mod_glo_bgc-bio_anfc_0.25deg_P1D-m

# 3. Google Earth Engine (Sentinel-2 L2A 10m + NOAA VIIRS Nighttime SST)
GEE_SERVICE_ACCOUNT=usv-satelital@your-gcp-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./service-account.json

# 4. Telemetría USV 48V vía Starlink Mini Indispensable + Backup RFD900x
STARLINK_MINI_GATEWAY_IP=192.168.100.1
USV_EDGE_JETSON_TOKEN=usv_trimaran_48v_stealth_auth_key
DEFAULT_SENSOR_TIER=MVP_BAJO_COSTO

# 5. Base de Datos Espacial PostgreSQL 16 + PostGIS
POSTGRES_USER=usv_admin
POSTGRES_PASSWORD=usv_stealth_48v_2026
POSTGRES_DB=pesca_satelital_gis
DATABASE_URL=postgresql://usv_admin:usv_stealth_48v_2026@postgis:5432/pesca_satelital_gis

# 6. Alertas Automáticas a Capitanes (Cortes 21:30 Camarón / 04:00 Jaiba / 04:45 Pescado)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
WHATSAPP_CLOUD_API_TOKEN=your_whatsapp_cloud_token
